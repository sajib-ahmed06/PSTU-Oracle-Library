DB_USER=
DB_PASSWORD=
DB_DSN=XE

# Set these in .env, then restart. Delivery stays off until enabled.
REMINDERS_ENABLED=false
REMINDER_SEND_HOUR=9
REMINDER_CHECK_SECONDS=300
# email works without an SMS provider; choose sms after configuring a gateway.
DUE_REMINDER_CHANNEL=email
SMS_REMINDERS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EMAIL_REMINDERS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
